# Front (exposées au navigateur)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serveur uniquement : /api/foods/barcode (fonction Vercel, et middleware Vite en dev)
# Ne jamais préfixer par VITE_ : la clé service_role contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Contact envoyé à Open Food Facts dans le User-Agent : FitTrack/1.0 (email)
OFF_CONTACT_EMAIL=

# Notifications push (Web Push). Générer la paire avec : npx web-push generate-vapid-keys
# La clé publique sert au navigateur et au serveur, la clé privée au serveur seulement.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'expéditeur (mailto:...). Facultatif : OFF_CONTACT_EMAIL sert par défaut.
VAPID_SUBJECT=
# Secret partagé avec pg_cron (Supabase) pour appeler /api/notifications/cron
CRON_SECRET=
